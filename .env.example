AZURE_CHAT_API_KEY=
AZURE_EMBEDDING_API_KEY=
AZURE_IMAGE_API_KEY=
# Optional endpoint override for the managed gpt-image-2 deployment.
# AGROCHAT_IMAGE_BASE=https://agro-llm.services.ai.azure.com/openai/v1
AGROCHAT_ORIGIN=http://127.0.0.1:8080
# Automatically generated locally; set a stable secret on Azure.
WEBUI_SECRET_KEY=
# Optional shared code for new profiles.
AGROCHAT_ENROLLMENT_CODE=
# AGROCHAT_MEMORY_INTERVAL_SECONDS=3600
# TOOL_SERVER_CONNECTIONS=[]
# Web Search starts enabled in new chats and uses DuckDuckGo by default.
# ENABLE_WEB_SEARCH=false
# WEB_SEARCH_ENGINE=duckduckgo
